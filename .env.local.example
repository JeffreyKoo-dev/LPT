# Supabase 프로젝트 설정 → Project Settings → API 에서 확인
# 이 파일을 복사해 .env.local로 만들고 실제 값을 채워넣으세요.
# .env.local은 .gitignore에 등록되어 있어 git에 커밋되지 않습니다.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# 카카오톡 공유하기 (선택) — Kakao Developers → 제품 설정 → 카카오톡 공유 활성화 후
# 앱 설정 → 앱 키 → JavaScript 키 확인. 없으면 카카오톡 공유 버튼이 자동으로 숨겨진다.
NEXT_PUBLIC_KAKAO_JS_KEY=your-kakao-javascript-key

# 캐시 결제(지갑) 기능 — 서버 전용, 절대 NEXT_PUBLIC_ 접두어 붙이지 말 것
# SUPABASE_SERVICE_ROLE_KEY: Supabase 대시보드 → Project Settings → API → service_role 키
# TOSS_SECRET_KEY: 토스페이먼츠 가입 후 발급받는 시크릿 키
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
TOSS_SECRET_KEY=your-toss-secret-key

# 토스페이먼츠 클라이언트 키 — 공개되는 값이라 NEXT_PUBLIC_ 접두어 사용
NEXT_PUBLIC_TOSS_CLIENT_KEY=your-toss-client-key

# 리워드 광고 (Google Ad Manager) — 승인 후 발급되는 광고 단위 경로
NEXT_PUBLIC_GAM_REWARDED_AD_UNIT=/YOUR_NETWORK_CODE/questofme_rewarded
